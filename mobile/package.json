  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup:adb": "bash scripts/setup-adb.sh",
    "start": "bash scripts/start-lan.sh",
    "start:lan": "bash scripts/start-lan.sh",
    "start:usb": "bash scripts/start-usb.sh",
    "start:tunnel": "expo start --tunnel",
    "start:api": "bash scripts/start-api.sh",
    "emulator": "bash scripts/emulator-lite.sh",
    "android": "bash scripts/start-lan.sh --android",
    "ios": "bash scripts/start-lan.sh --ios",
    "eas:build:apk": "npx --yes eas-cli@21.2.0 build -p android --profile android-direct",
    "eas:build:local": "npx --yes eas-cli@21.2.0 build -p android --profile android-direct --local",
    "eas:build:aab": "npx --yes eas-cli@21.2.0 build -p android --profile android-store",
    "eas:build:ios": "npx --yes eas-cli@21.2.0 build -p ios --profile ios-testflight",
    "eas:build:ios:prod": "npx --yes eas-cli@21.2.0 build -p ios --profile ios-testflight",
    "eas:build:all": "npm run eas:build:apk && npm run eas:build:ios",
    "prebuild:android": "npx expo prebuild --platform android --no-install",
    "prebuild:ios": "npx expo prebuild --platform ios --no-install",
    "android:device": "npx expo run:android",
    "android:debug-apk": "bash scripts/build-debug-apk.sh",
    "android:usb": "bash scripts/install-usb.sh",
    "android:usb-check": "bash scripts/usb-check.sh"
  },
  "private": true
