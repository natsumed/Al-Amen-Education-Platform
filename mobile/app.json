{
  "expo": {
    "name": "Amenallah",
    "slug": "al-amen-education",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "alamen",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tn.amenallah.education",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:amanallahedition.com"],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Amenallah utilise votre photo uniquement pour votre avatar.",
        "NSCameraUsageDescription": "Amenallah utilise la caméra uniquement pour votre avatar.",
        "NSPhotoLibraryAddUsageDescription": "Amenallah n'enregistre pas de photos dans votre bibliothèque.",
        "CFBundleAllowMixedLocalizations": true,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false
        }
      }
    },
    "android": {
      "package": "tn.amenallah.education",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2040e0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
      ,"intentFilters": [
        { "action": "VIEW", "autoVerify": true, "category": ["BROWSABLE", "DEFAULT"], "data": [{ "scheme": "https", "host": "amanallahedition.com", "pathPrefix": "/content" }] },
        { "action": "VIEW", "autoVerify": true, "category": ["BROWSABLE", "DEFAULT"], "data": [{ "scheme": "https", "host": "amanallahedition.com", "pathPrefix": "/reset-password" }] },
        { "action": "VIEW", "autoVerify": true, "category": ["BROWSABLE", "DEFAULT"], "data": [{ "scheme": "https", "host": "amanallahedition.com", "pathPrefix": "/verify-email" }] }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Amenallah utilise votre photo uniquement pour votre avatar."
        }
      ],
      "expo-notifications",
      "expo-apple-authentication",
      "expo-secure-store",
      "./plugins/with-secure-content.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2040e0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-image",
      "expo-font"
    ],
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
