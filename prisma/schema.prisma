generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// String fields intentionally remain application-level unions in src/types/index.ts.

model User {
  id                 String    @id @default(uuid())
  publicId           String    @unique
  email              String    @unique
  passwordHash       String?
  phone              String?
  fullName           String
  role               String    @default("STUDENT")
  avatarUrl          String?
  googleId           String?   @unique
  emailVerified      DateTime?
  onboardingCompletedAt DateTime?
  resetToken         String?
  resetTokenExp      DateTime?
  isBanned           Boolean   @default(false)
  preferredLanguage  String?
  emailNotifications Boolean   @default(true)
  sessionVersion     Int       @default(0)
  passwordUpdatedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  subscriptions          Subscription[]
  payments               Payment[]
  beneficiaryPayments    Payment[]             @relation("PaymentBeneficiary")
  reviews                Review[]
  progress               Progress[]
  parentLinks            ParentLink[]          @relation("Parent")
  studentLinks           ParentLink[]          @relation("Student")
  manualActivations      ManualActivationLog[] @relation("Admin")
  activatedSubscriptions ManualActivationLog[] @relation("TargetUser")
  uploadedContent        Content[]             @relation("UploadedBy")
  purchases              Purchase[]
  deviceTokens           DeviceToken[]
  deviceSessions         DeviceSession[]
  playbackSessions       PlaybackSession[]
  ingestionJobs          IngestionJob[]        @relation("IngestionRequestedBy")
  reviewedIngestionJobs  IngestionJob[]        @relation("IngestionReviewedBy")
  auditEvents            AuditEvent[]
  mfaCredential          MfaCredential?
  externalAccounts       ExternalAccount[]
  authChallenges         AuthChallenge[]
  oneTimeTokens          OneTimeToken[]
  emailOutbox            EmailOutbox[]
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  plan      String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, endDate])
}

model Payment {
  id                String    @id @default(uuid())
  userId            String
  beneficiaryUserId String?
  amount            Float
  currency          String    @default("TND")
  provider          String
  status            String    @default("PENDING")
  transactionRef    String?
  merchantOrderRef  String?   @unique
  amountMillis      Int?
  callbackDigest    String?
  verifiedAt        DateTime?
  reconciledAt      DateTime?
  itemType          String
  itemId            String?
  createdAt         DateTime  @default(now())

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiary User? @relation("PaymentBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([beneficiaryUserId])
  @@index([transactionRef])
  @@index([status])
}

model Content {
  id            String   @id @default(uuid())
  titleAr       String
  titleFr       String
  descriptionAr String?
  descriptionFr String?
  grade         String
  subject       String
  contentType   String
  isFree        Boolean  @default(true)
  price         Float?
  thumbnailUrl  String?
  youtubeUrl    String?
  pdfUrl        String?
  gifUrl        String?
  fileUrls      String   @default("[]")
  status        String   @default("PUBLISHED")
  uploadedById  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploadedBy       User              @relation("UploadedBy", fields: [uploadedById], references: [id])
  reviews          Review[]
  progress         Progress[]
  purchases        Purchase[]
  assets           ContentAsset[]
  playbackSessions PlaybackSession[]
  ingestionJobs    IngestionJob[]

  @@index([grade, subject])
  @@index([contentType])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model Progress {
  id              String   @id @default(uuid())
  userId          String
  contentId       String
  completed       Boolean  @default(false)
  progressPercent Int      @default(0)
  lastAccessed    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model ParentLink {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  parent  User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

model ManualActivationLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String
  plan         String
  durationDays Int
  reason       String?
  createdAt    DateTime @default(now())

  admin      User @relation("Admin", fields: [adminId], references: [id])
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id])
}

model ContentAsset {
  id                 String   @id @default(uuid())
  contentId          String?
  kind               String
  sourceProvider     String   @default("DRIVE")
  sourceRefEncrypted String?
  deliveryProvider   String?
  deliveryAssetId    String?
  status             String   @default("PENDING")
  mimeType           String?
  checksumSha256     String?
  sizeBytes          BigInt?
  pageCount          Int?
  failureReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  content          Content?          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ingestionJobs    IngestionJob[]
  playbackSessions PlaybackSession[]

  @@index([contentId, kind])
  @@index([status])
}

model IngestionJob {
  id                 String    @id @default(uuid())
  requestedById      String
  reviewedById       String?
  contentId          String?
  assetId            String?
  sourceType         String
  sourceRefEncrypted String
  status             String    @default("QUEUED")
  progressPercent    Int       @default(0)
  instructions       String?
  proposal           Json?
  confidence         Float?
  errorCode          String?
  errorMessage       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requestedBy User          @relation("IngestionRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?         @relation("IngestionReviewedBy", fields: [reviewedById], references: [id])
  content     Content?      @relation(fields: [contentId], references: [id], onDelete: SetNull)
  asset       ContentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestedById])
}

model DeviceSession {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  platform   String
  deviceName String?
  attestedAt DateTime?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  playbackSessions PlaybackSession[]

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
}

model RefreshToken {
  id              String    @id @default(uuid())
  deviceSessionId String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  deviceSession DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)

  @@index([deviceSessionId, expiresAt])
}

model PlaybackSession {
  id              String    @id @default(uuid())
  sessionCode     String    @unique
  userId          String
  contentId       String
  assetId         String
  deviceSessionId String?
  ipHash          String?
  expiresAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset         ContentAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceSession DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, endedAt, expiresAt])
  @@index([contentId])
}

model MfaCredential {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  type                   String    @default("TOTP")
  secretEncrypted        String
  recoveryCodesEncrypted String?
  enabledAt              DateTime?
  lastUsedCounter        BigInt?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model MobileRelease {
  id             String    @id @default(uuid())
  platform       String
  artifactType   String    @default("APK")
  version        String
  buildNumber    Int
  url            String
  checksumSha256 String?
  signatureSha256 String?
  sizeBytes      BigInt?
  minimumVersion String?
  minimumBuildNumber Int?
  appStoreUrl    String?
  isMandatory    Boolean   @default(false)
  isPublished    Boolean   @default(false)
  releasedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([platform, buildNumber])
  @@index([platform, isPublished, buildNumber])
}

model ExternalAccount {
  id                String   @id @default(uuid())
  provider          String
  providerAccountId String
  userId            String
  emailAtLink       String?
  revokedAt         DateTime?
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model AuthChallenge {
  id          String   @id @default(uuid())
  userId      String?
  type        String
  provider    String?
  payload     Json?
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([expiresAt])
}

model OneTimeToken {
  id         String   @id @default(uuid())
  userId     String
  purpose    String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([purpose, tokenHash])
  @@index([userId, purpose, expiresAt])
}

model EmailOutbox {
  id              String    @id @default(uuid())
  userId          String?
  type            String
  recipient       String
  locale          String    @default("fr")
  payloadEncrypted String?
  templateVersion String    @default("v1")
  idempotencyKey  String    @unique
  status          String    @default("PENDING")
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(now())
  providerMessageId String?
  sentAt          DateTime?
  expiresAt       DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([recipient, createdAt])
}
