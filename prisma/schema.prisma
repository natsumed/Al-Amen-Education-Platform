generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Most legacy string fields remain application-level unions. Payment fields use
// database enums because invalid financial state transitions must fail closed.

enum PaymentProvider {
  MANUAL_CASH
  CLICTOPAY
}

enum PaymentProductKind {
  SUBSCRIPTION
  CONTENT
}

enum PaymentStatus {
  CREATED
  PENDING_REVIEW
  REDIRECT_READY
  PROCESSING
  SUCCEEDED
  DECLINED
  CANCELLED
  EXPIRED
  INITIATION_FAILED
  RECONCILIATION_REQUIRED
  REFUND_PENDING
  REFUNDED
}

enum PaymentGrantSource {
  PAYMENT
  ADMIN_GRANT
  LEGACY_IMPORT
}

enum EntitlementStatus {
  ACTIVE
  REVERSED
}

model User {
  id                    String    @id @default(uuid())
  publicId              String    @unique
  email                 String    @unique
  passwordHash          String?
  phone                 String?
  fullName              String
  role                  String    @default("STUDENT")
  avatarUrl             String?
  googleId              String?   @unique
  emailVerified         DateTime?
  onboardingCompletedAt DateTime?
  resetToken            String?
  resetTokenExp         DateTime?
  isBanned              Boolean   @default(false)
  preferredLanguage     String?
  emailNotifications    Boolean   @default(true)
  sessionVersion        Int       @default(0)
  passwordUpdatedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  subscriptions          Subscription[]
  payments               Payment[]
  beneficiaryPayments    Payment[]             @relation("PaymentBeneficiary")
  reviews                Review[]
  progress               Progress[]
  parentLinks            ParentLink[]          @relation("Parent")
  studentLinks           ParentLink[]          @relation("Student")
  manualActivations      ManualActivationLog[] @relation("Admin")
  activatedSubscriptions ManualActivationLog[] @relation("TargetUser")
  uploadedContent        Content[]             @relation("UploadedBy")
  purchases              Purchase[]
  deviceTokens           DeviceToken[]
  deviceSessions         DeviceSession[]
  playbackSessions       PlaybackSession[]
  ingestionJobs          IngestionJob[]        @relation("IngestionRequestedBy")
  reviewedIngestionJobs  IngestionJob[]        @relation("IngestionReviewedBy")
  auditEvents            AuditEvent[]
  mfaCredential          MfaCredential?
  externalAccounts       ExternalAccount[]
  authChallenges         AuthChallenge[]
  oneTimeTokens          OneTimeToken[]
  emailOutbox            EmailOutbox[]
  subscriptionGrants     SubscriptionGrant[]
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  plan      String
  status    String   @default("ACTIVE")
  startDate DateTime @default(now())
  endDate   DateTime
  autoRenew Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, endDate])
}

model Payment {
  id                       String             @id @default(uuid())
  userId                   String
  beneficiaryUserId        String?
  productKind              PaymentProductKind
  productId                String
  productTitle             String
  plan                     String?
  planDurationDays         Int?
  amount                   Float
  amountMillis             Int
  currency                 String             @default("TND")
  provider                 PaymentProvider
  status                   PaymentStatus      @default(CREATED)
  transactionRef           String?
  merchantOrderRef         String             @unique
  providerOrderRef         String?            @unique
  providerTransactionRef   String?            @unique
  idempotencyKey           String?
  idempotencyFingerprint   String?
  callbackDigest           String?
  failureCode              String?
  failureMessage           String?
  termsAcceptedAt          DateTime?
  initiatedAt              DateTime?
  redirectedAt             DateTime?
  expiresAt                DateTime?
  verifiedAt               DateTime?
  settledAt                DateTime?
  failedAt                 DateTime?
  cancelledAt              DateTime?
  refundedAt               DateTime?
  reconciledAt             DateTime?
  processingLeaseId        String?
  processingLeaseExpiresAt DateTime?
  // Compatibility columns retained for one rollback window.
  itemType                 String
  itemId                   String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiary       User?              @relation("PaymentBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  events            PaymentEvent[]
  subscriptionGrant SubscriptionGrant?
  purchase          Purchase?

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([beneficiaryUserId])
  @@index([transactionRef])
  @@index([status])
  @@index([provider, status, expiresAt])
  @@index([processingLeaseExpiresAt])
}

model PaymentEvent {
  id               String         @id @default(uuid())
  paymentId        String
  eventType        String
  eventDigest      String         @unique
  providerEventRef String?
  normalizedStatus PaymentStatus?
  verified         Boolean        @default(false)
  metadata         Json?
  processingError  String?
  processedAt      DateTime?
  createdAt        DateTime       @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, providerEventRef])
  @@index([paymentId, createdAt])
  @@index([verified, createdAt])
}

model SubscriptionGrant {
  id           String             @id @default(uuid())
  userId       String
  paymentId    String?            @unique
  plan         String
  source       PaymentGrantSource
  durationDays Int
  startsAt     DateTime
  endsAt       DateTime
  status       EntitlementStatus  @default(ACTIVE)
  reversedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, status, endsAt])
}

model Content {
  id            String   @id @default(uuid())
  displayTitle  String   @default("")
  primaryLanguage String @default("MULTI")
  titleAr       String   @default("")
  titleFr       String   @default("")
  titleEn       String?
  descriptionAr String?
  descriptionFr String?
  descriptionEn String?
  grade         String
  subject       String
  contentType   String
  language      String   @default("MULTI")
  audience      String   @default("LEARNER")
  collectionKey String?
  storyKey      String?
  editionLabel  String?
  category      String?
  isFree        Boolean  @default(true)
  price         Float?
  priceMillis   Int?
  thumbnailUrl  String?
  youtubeUrl    String?
  pdfUrl        String?
  gifUrl        String?
  fileUrls      String   @default("[]")
  status        String   @default("DRAFT")
  uploadedById  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploadedBy       User              @relation("UploadedBy", fields: [uploadedById], references: [id])
  reviews          Review[]
  progress         Progress[]
  purchases        Purchase[]
  assets           ContentAsset[]
  playbackSessions PlaybackSession[]
  ingestionJobs    IngestionJob[]

  @@index([grade, subject])
  @@index([contentType])
  @@index([status])
  @@index([category, status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model Progress {
  id              String   @id @default(uuid())
  userId          String
  contentId       String
  completed       Boolean  @default(false)
  progressPercent Int      @default(0)
  lastAccessed    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model ParentLink {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  parent  User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Purchase {
  id        String            @id @default(uuid())
  userId    String
  contentId String
  paymentId String?           @unique
  status    EntitlementStatus @default(ACTIVE)
  revokedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  content Content  @relation(fields: [contentId], references: [id], onDelete: Restrict)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, contentId])
  @@index([userId])
}

model ManualActivationLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String
  plan         String
  durationDays Int
  reason       String?
  createdAt    DateTime @default(now())

  admin      User @relation("Admin", fields: [adminId], references: [id])
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id])
}

model ContentAsset {
  id                 String   @id @default(uuid())
  contentId          String?
  kind               String
  sourceProvider     String   @default("DRIVE")
  sourceRefEncrypted String?
  sourceFileIdHash   String?
  sourceFileName     String?
  locale             String?
  assetRole          String   @default("PRIMARY")
  deliveryProvider   String?
  deliveryAssetId    String?
  status             String   @default("PENDING")
  mimeType           String?
  checksumSha256     String?
  sizeBytes          BigInt?
  pageCount          Int?
  failureReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  content          Content?          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  ingestionJobs    IngestionJob[]
  playbackSessions PlaybackSession[]

  @@index([contentId, kind])
  @@index([status])
  @@index([sourceFileIdHash])
}

model ContentIntake {
  id                 String    @id @default(uuid())
  sourceType         String
  sourceProvider     String    @default("DRIVE")
  sourceRefEncrypted String?
  sourceFileIdHash   String    @unique
  sourceFileName     String
  sourceFolder       String?
  sourceEmailRef     String?
  mimeType           String?
  sizeBytes          BigInt?
  checksumSha256     String?
  language           String?
  category           String?
  titleAr            String?
  titleFr            String?
  titleEn            String?
  grade              String?
  subject            String?
  audience           String?
  collectionKey      String?
  storyKey           String?
  editionLabel       String?
  coverRelationship  String?
  ownership          String?
  sharingState       String?
  duplicateOfId      String?
  status             String    @default("RECEIVED")
  aiProposal         Json?
  reviewNotes        String?
  errorCode          String?
  errorMessage       String?
  reviewedById       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([category, language])
  @@index([storyKey])
}

model IngestionJob {
  id                 String    @id @default(uuid())
  requestedById      String
  reviewedById       String?
  contentId          String?
  assetId            String?
  sourceType         String
  sourceRefEncrypted String
  status             String    @default("QUEUED")
  progressPercent    Int       @default(0)
  instructions       String?
  proposal           Json?
  confidence         Float?
  errorCode          String?
  errorMessage       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requestedBy User          @relation("IngestionRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?         @relation("IngestionReviewedBy", fields: [reviewedById], references: [id])
  content     Content?      @relation(fields: [contentId], references: [id], onDelete: SetNull)
  asset       ContentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([requestedById])
}

model DeviceSession {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  platform   String
  deviceName String?
  attestedAt DateTime?
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  playbackSessions PlaybackSession[]

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
}

model RefreshToken {
  id              String    @id @default(uuid())
  deviceSessionId String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  deviceSession DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)

  @@index([deviceSessionId, expiresAt])
}

model PlaybackSession {
  id              String    @id @default(uuid())
  sessionCode     String    @unique
  userId          String
  contentId       String
  assetId         String
  deviceSessionId String?
  ipHash          String?
  expiresAt       DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  asset         ContentAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceSession DeviceSession? @relation(fields: [deviceSessionId], references: [id], onDelete: SetNull)

  @@index([userId, endedAt, expiresAt])
  @@index([contentId])
}

model MfaCredential {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  type                   String    @default("TOTP")
  secretEncrypted        String
  recoveryCodesEncrypted String?
  enabledAt              DateTime?
  lastUsedCounter        BigInt?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  ipHash     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model MobileRelease {
  id                 String    @id @default(uuid())
  platform           String
  artifactType       String    @default("APK")
  version            String
  buildNumber        Int
  url                String
  checksumSha256     String?
  signatureSha256    String?
  sizeBytes          BigInt?
  minimumVersion     String?
  minimumBuildNumber Int?
  appStoreUrl        String?
  sourceCommit       String?
  isMandatory        Boolean   @default(false)
  isPublished        Boolean   @default(false)
  releasedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@unique([platform, buildNumber])
  @@index([platform, isPublished, buildNumber])
}

model ExternalAccount {
  id                String    @id @default(uuid())
  provider          String
  providerAccountId String
  userId            String
  emailAtLink       String?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  lastLoginAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model AuthChallenge {
  id         String    @id @default(uuid())
  userId     String?
  type       String
  provider   String?
  payload    Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@index([expiresAt])
}

model OneTimeToken {
  id         String    @id @default(uuid())
  userId     String
  purpose    String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([purpose, tokenHash])
  @@index([userId, purpose, expiresAt])
}

model EmailOutbox {
  id                String    @id @default(uuid())
  userId            String?
  type              String
  recipient         String
  locale            String    @default("fr")
  payloadEncrypted  String?
  templateVersion   String    @default("v1")
  idempotencyKey    String    @unique
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  providerMessageId String?
  sentAt            DateTime?
  expiresAt         DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([recipient, createdAt])
}
