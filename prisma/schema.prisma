generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
  TEACHER
  PARENT
}

enum Grade {
  GRADE_1
  GRADE_2
  GRADE_3
  GRADE_4
  GRADE_5
  GRADE_6
}

enum Subject {
  ARABIC
  FRENCH
  MATH
  SCIENCE
  ISLAMIC
  HISTORY
  CIVIC
  ARTS
  ENGLISH
}

enum ContentType {
  COURSE
  BOOK
  SERIES
  ANIMATION
}

enum SubscriptionPlan {
  FREE
  STUDENT_MONTHLY
  STUDENT_YEARLY
  TEACHER_MONTHLY
  TEACHER_YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  KONNECT
  FLOUCI
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum ParentLinkStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  phone         String?
  fullName      String
  role          Role      @default(STUDENT)
  avatarUrl     String?
  googleId      String?   @unique
  emailVerified DateTime?
  resetToken    String?
  resetTokenExp DateTime?
  isBanned      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptions          Subscription[]
  payments               Payment[]
  reviews                Review[]
  progress               Progress[]
  parentLinks            ParentLink[]          @relation("Parent")
  studentLinks           ParentLink[]          @relation("Student")
  manualActivations      ManualActivationLog[] @relation("Admin")
  activatedSubscriptions ManualActivationLog[] @relation("TargetUser")
  uploadedContent        Content[]             @relation("UploadedBy")
  purchases              Purchase[]
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  autoRenew Boolean            @default(false)
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, endDate])
}

model Payment {
  id             String          @id @default(uuid())
  userId         String
  amount         Float
  currency       String          @default("TND")
  provider       PaymentProvider
  status         PaymentStatus   @default(PENDING)
  transactionRef String?
  itemType       String
  itemId         String?
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionRef])
}

model Content {
  id            String      @id @default(uuid())
  titleAr       String
  titleFr       String
  descriptionAr String?
  descriptionFr String?
  grade         Grade
  subject       Subject
  contentType   ContentType
  isFree        Boolean     @default(true)
  price         Float?
  thumbnailUrl  String?
  youtubeUrl    String?
  pdfUrl        String?
  gifUrl        String?
  fileUrls      String      @default("[]")
  status        String      @default("PUBLISHED")
  uploadedById  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  uploadedBy User      @relation("UploadedBy", fields: [uploadedById], references: [id])
  reviews    Review[]
  progress   Progress[]
  purchases  Purchase[]

  @@index([grade, subject])
  @@index([contentType])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model Progress {
  id              String   @id @default(uuid())
  userId          String
  contentId       String
  completed       Boolean  @default(false)
  progressPercent Int      @default(0)
  lastAccessed    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
}

model ParentLink {
  id        String           @id @default(uuid())
  parentId  String
  studentId String
  status    ParentLinkStatus @default(PENDING)
  createdAt DateTime         @default(now())

  parent  User @relation("Parent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  contentId String
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
}

model ManualActivationLog {
  id           String           @id @default(uuid())
  adminId      String
  targetUserId String
  plan         SubscriptionPlan
  durationDays Int
  reason       String?
  createdAt    DateTime         @default(now())

  admin      User @relation("Admin", fields: [adminId], references: [id])
  targetUser User @relation("TargetUser", fields: [targetUserId], references: [id])
}
