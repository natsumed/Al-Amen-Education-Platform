# Environment template — copy to .env.local (never commit secrets)

# Database (PostgreSQL for local and production)
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-secret"

# Optional Google OAuth
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Transactional email (Spacemail SMTP; keep the password only in a secret store)
# SMTP_HOST=mail.spacemail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@amanallahedition.com
# SMTP_PASSWORD=
# SMTP_FROM="Amenallah Edition <support@amanallahedition.com>"
# SMTP_REPLY_TO=support@amanallahedition.com
# EMAIL_WORKER_ENABLED=true

# Supabase Storage (private `content` bucket for PDFs, images, and GIFs)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# App URL (for emails / mobile deep links later)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Drive content intake. The service account must have access only to
# the private content library; never expose these values to the browser.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_DRIVE_MASTERS_FOLDER_ID=
# GOOGLE_DRIVE_OWNER_EMAIL=amenallahplatform@gmail.com
# CONTENT_WORKER_ENABLED=true
# CONTENT_SCAN_REQUIRED=true
# CLAMSCAN_BIN=clamscan
# PDFTOTEXT_BIN=pdftotext
# PDFINFO_BIN=pdfinfo
# PDFTOPPM_BIN=pdftoppm

# Help chatbot — free Gemini Flash (Google AI Studio) for natural dialogue + tools.
# Required for full NL agent; without it the app uses a smart DB-backed offline agent.
# After setting the key, restart `next dev`.
# Prefer lite models on free tier (less “high demand” 503s). Cascade via GEMINI_FALLBACK_MODELS.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash
# Optional fallback: OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
