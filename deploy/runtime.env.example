# Copy to /opt/amenallah/runtime.env on the VPS. Never commit the real file.
IMAGE_NAME=ghcr.io/natsumed/al-amen-education-platform
PROD_IMAGE_TAG=replace-with-production-commit-sha
STAGING_IMAGE_TAG=replace-with-staging-commit-sha
PROD_POSTGRES_PASSWORD=generate-a-unique-long-password
STAGING_POSTGRES_PASSWORD=generate-a-different-long-password
PROD_AUTH_SECRET=generate-with-openssl-rand-base64-32
STAGING_AUTH_SECRET=generate-a-different-secret
PROD_DATA_ENCRYPTION_KEY=generate-with-openssl-rand-base64-32
STAGING_DATA_ENCRYPTION_KEY=generate-a-different-base64-key
PROD_AUDIT_HASH_KEY=generate-with-openssl-rand-base64-32
STAGING_AUDIT_HASH_KEY=generate-a-different-secret
TLS_EMAIL=support@amanallahedition.com
STAGING_BASIC_AUTH_USER=reviewer
STAGING_BASIC_AUTH_HASH=generate-with-caddy-hash-password

# Optional integrations. Leave blank unless configured and verified.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@amanallahedition.com
SMTP_PASSWORD=
SMTP_FROM="Amenallah Edition <support@amanallahedition.com>"
SMTP_REPLY_TO=support@amanallahedition.com
EMAIL_WORKER_ENABLED=true
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
STAGING_AUTH_GOOGLE_ID=
STAGING_AUTH_GOOGLE_SECRET=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_CLIENT_ID=
MOBILE_APPLE_BUNDLE_ID=tn.amenallah.education
VDOCIPHER_API_SECRET=
MOBILE_ATTESTATION_ENFORCED=false
OPENAI_API_KEY=
OPENAI_INGESTION_MODEL=gpt-5-mini
CLICTOPAY_ENABLED=false
CLICTOPAY_MERCHANT_ID=
CLICTOPAY_API_URL=
CLICTOPAY_API_SECRET=

# Keep legacy media temporarily during controlled migration. Turn it off only
# after every published asset has a verified secure-delivery record.
PROD_ALLOW_LEGACY_MEDIA=true
STAGING_ALLOW_LEGACY_MEDIA=true
PROD_MOBILE_NATIVE_CONTENT_ONLY=false
STAGING_MOBILE_NATIVE_CONTENT_ONLY=false
PROD_SECURE_CONTENT_ENABLED=false
STAGING_SECURE_CONTENT_ENABLED=false
