{
  email {$TLS_EMAIL}
}

{$APP_DOMAIN} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
  reverse_proxy prod-app:3000 {
    # Keep the public request origin intact for Next.js middleware and Auth.js.
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto https
  }
}

www.{$APP_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

{$STAGING_DOMAIN} {
  basic_auth {
    {$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
  }
  encode zstd gzip
  reverse_proxy staging-app:3000 {
    header_up Host {host}
    header_up X-Forwarded-Host {host}
    header_up X-Forwarded-Proto https
  }
}
