# Copy to /opt/amenallah/restic.env on the VPS and keep mode 600.
# Use a dedicated off-server S3-compatible bucket, not the VPS disk.
RESTIC_REPOSITORY=s3:https://s3.example.com/amenallah-backups
RESTIC_PASSWORD=replace-with-a-long-random-backup-password
AWS_ACCESS_KEY_ID=replace-with-a-dedicated-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-the-dedicated-backup-secret
